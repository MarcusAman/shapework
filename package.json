{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude src --exclude tests --exclude public --exclude node_modules --exclude dist --exclude vite.config.ts server.ts",
    "dev:local": "node scripts/start-local-dev.mjs",
    "test:local-routes": "node scripts/check-local-routes.mjs",
    "test:quickbooks": "tsx scripts/verify-quickbooks.ts",
    "test:basecamp": "tsx scripts/verify-basecamp.ts",
    "test:runtime-migration": "tsx scripts/test-runtime-migration.ts",
    "test:brokerage-ops": "tsx scripts/test-brokerage-ops.ts",
    "test:tapo-camera": "tsx scripts/test-tapo-camera.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@37signals/basecamp": "^0.7.3",
    "@azure/msal-node": "^5.3.1",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@elevenlabs/elevenlabs-js": "^2.56.0",
    "@google/genai": "^2.4.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "googleapis": "^173.0.0",
    "intuit-oauth": "^4.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
